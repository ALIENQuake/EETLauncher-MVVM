<Window
    x:Class="EETLauncherWPF.EETLauncherSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:EETLauncherWPF"
    mc:Ignorable="d"
    Title="EETLauncherSettings" Height="361" Width="345" Background="Black" Foreground="White" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
    MouseLeftButtonDown="Window_MouseLeftButtonDown"
    >
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/EETLauncher;component/Resources/EETLauncher-Background.bmp"/>
        </Grid.Background>
        <Image Source="Resources/EETLauncher-Logo.png" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        <StackPanel Margin="85,90,91,28" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Height="243" Width="169">
            <Separator Width="48" Height="24" Background="Transparent"  VerticalAlignment="Top"/>
            <Label x:Name="EETLauncherSettings_L_Settings" Content="SETTINGS" VerticalAlignment="Top" Foreground="White"/>
            <Separator Width="48" Height="12" Background="Transparent"  VerticalAlignment="Top"/>
            <Label x:Name="EETLauncherSettings_L_CurrentGui" Content="{ Binding CurrentGui, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=??? }" ContentStringFormat="CURRENT EET GUI: {0}" VerticalAlignment="Top" Height="30" Foreground="{ Binding Color, FallbackValue=White }" IsEnabled="{ Binding Enabled }" />
            <Button x:Name="EETLauncherSettings_LB_ChangeGui" Content="{ Binding ChangeTo, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=??? }" ContentStringFormat="CHANGE TO {0}" VerticalAlignment="Top" Height="30" Command="{ Binding ChangeEETGuiAsync }" Foreground="{ Binding Color, FallbackValue=White }" IsEnabled="{ Binding Enabled }" />
            <Button x:Name="EETLauncherSettings_LB_OpenEETLua" Content="OPEN EET Baldur.lua" VerticalAlignment="Top" Command="{ Binding OpenEETLua }" />
            <Separator Width="48" Height="48" Background="Transparent"  VerticalAlignment="Top"/>
            <Button x:Name="EETLauncherSettings_LB_Back" Content="BACK" Margin="60,0" Click="EETLauncherSettings_LB_Back_Click" />
        </StackPanel>
        <TextBox Name="EETLauncherSettings_TB_Log" VerticalAlignment="Bottom" Width="345" IsEnabled="{ Binding Enabled, FallbackValue=false }" Visibility="{ Binding LogVisibility }"/>
    </Grid>
</Window>
